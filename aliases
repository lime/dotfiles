alias ll="ls -lA"
if (( $+commands[eza] )); then
  alias ll="eza -lA"
fi
if (( $+commands[lsd] )); then
  alias ll="lsd -lA"
fi

if (( $+commands[bat] )); then
  alias cat=bat
  alias bl="bat --paging=always"
fi

alias lower="tr '[:upper:]' '[:lower:]'"
alias upper="tr '[:lower:]' '[:upper:]'"
alias uuid="uuidgen | lower"
alias nr="npm run"
alias pn=pnpm
